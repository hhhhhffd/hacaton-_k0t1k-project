# ============================================================
# _k0t1k Project — переменные окружения
# ============================================================
# Скопируйте: cp .env.example .env
# Заполните реальными ключами перед запуском.
#
# ЕДИНЫЙ .env для всего стека (backend + frontend + docker-compose).
# Фронтенд получает GOOGLE_CLIENT_ID через docker-compose build args.

# === PostgreSQL (docker-compose) ===
POSTGRES_DB=k0t1k
POSTGRES_USER=k0t1k
POSTGRES_PASSWORD=k0t1k_local

# === Redis (docker-compose переопределяет) ===
REDIS_URL=redis://localhost:6379/0

# === Qwen 3.5 LLM (alem.plus) ===
LLM_BASE_URL=https://llm.alem.ai/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=qwen3

# === Embedder text-1024 (alem.plus) ===
EMBEDDER_URL=https://llm.alem.ai/v1
EMBEDDER_API_KEY=your-embedder-api-key-here
EMBEDDER_MODEL=text-1024

# === Score API / Reranker (alem.plus) ===
SCORE_API_URL=https://reranker-llm.alem.ai/v1
SCORE_API_KEY=your-score-api-key-here

# === Auth (JWT) ===
# Если не задан — генерируется рандомный при каждом запуске
# (токены инвалидируются при рестарте, задайте фиксированный для продакшена)
JWT_SECRET_KEY=your-jwt-secret-here

# === Google OAuth (опционально) ===
# Получить на https://console.cloud.google.com/apis/credentials
# Автоматически пробрасывается на фронтенд через docker-compose build args
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === CORS ===
CORS_ORIGINS=["http://localhost:80","http://localhost:5173"]

# === Cloudflare Tunnel (опционально) ===
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
